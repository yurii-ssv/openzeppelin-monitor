# Variable NAMES only. Copy to `.env` (untracked) and fill in; never commit values.
# `deploy/render.sh` and the Monitor read these from the environment; the rendered config only
# refers to the names.

# --- Monitor (docker-compose.yaml passes these through) ---
RUST_LOG=info
# Additional logging options (file mode)...by default is stdout
# See docker-compose.yaml for more details
# LOG_MODE=file
# LOG_DATA_DIR=logs/
# LOG_MAX_SIZE=1073741824
# METRICS_ENABLED=false
# Persistent Monitor data (last processed block, failed-tx inbox); default ./data
# MONITOR_DATA_DIR=data/

# Ethereum mainnet RPC. History eth_getLogs needs an archive-capable endpoint for one-shot
# replays; the second endpoint is optional (a fallback, used only when set).
MAINNET_RPC_URL=
MAINNET_RPC_URL_2=

# Page / warn route (Telegram). TELEGRAM_CHAT_ID is substituted by deploy/render.sh into the
# Telegram triggers at render time (the Monitor schema has no secret type for it).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Info route (Discord, D2/D11): the six *_SUCCESS triggers (cluster, dao, liquidation, operator,
# oracle, validator) and the M11 other-sender alert all post here.
DISCORD_WEBHOOK_INFO=

# Dedicated Discord webhooks kept per D11: the six *_FAILED triggers, ORACLE_DISSENT,
# DAO_SAFE_FAILED and LARGE_ETH_TRANSFER.
DISCORD_WEBHOOK_CLUSTER_FAILED=
DISCORD_WEBHOOK_DAO_FAILED=
DISCORD_WEBHOOK_DAO_SAFE_FAILED=
DISCORD_WEBHOOK_LARGE_ETH_TRANSFER=
DISCORD_WEBHOOK_LIQUIDATION_FAILED=
DISCORD_WEBHOOK_OPERATOR_FAILED=
DISCORD_WEBHOOK_ORACLE_DISSENT=
DISCORD_WEBHOOK_ORACLE_FAILED=
DISCORD_WEBHOOK_VALIDATOR_FAILED=

# --- Local dry run (scripts/local-dry-run.sh): alerts go ONLY to these test channels ---
# TEST_RPC_URL=https://ethereum-rpc.publicnode.com
# TEST_DISCORD_WEBHOOK=
# TEST_TELEGRAM_TOKEN=
# TEST_TELEGRAM_CHAT_ID=
