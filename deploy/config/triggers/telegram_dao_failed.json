{
  "telegram_dao_failed": {
    "name": "DAO Failed Alert",
    "trigger_type": "telegram",
    "config": {
      "token": {
        "type": "environment",
        "value": "TELEGRAM_TOKEN"
      },
      "chat_id": "${TELEGRAM_CHAT_ID}",
      "disable_web_preview": true,
      "message": {
        "title": "FAILED DAO Action",
        "body": "Function: ${functions.0.signature}\nCalled by: ${transaction.from}\nEtherscan: [mainnet](https://etherscan.io/tx/${transaction.hash}) | [hoodi](https://hoodi.etherscan.io/tx/${transaction.hash})\n\n${functions}"
      }
    }
  }
}
