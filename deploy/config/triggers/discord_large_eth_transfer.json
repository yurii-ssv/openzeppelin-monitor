{
  "discord_large_eth_transfer": {
    "name": "Discord Large ETH Transfer Alert",
    "trigger_type": "discord",
    "config": {
      "discord_url": {
        "type": "environment",
        "value": "DISCORD_WEBHOOK_LARGE_ETH_TRANSFER"
      },
      "message": {
        "title": "Large ETH Transfer (>1 ETH)",
        "body": "Value: ${transaction.value} wei\nFrom: ${transaction.from}\nTo: ${transaction.to}\nEtherscan: [mainnet](https://etherscan.io/tx/${transaction.hash}) | [hoodi](https://hoodi.etherscan.io/tx/${transaction.hash})\n\n${functions}"
      }
    }
  }
}
